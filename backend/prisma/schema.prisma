generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id               Int      @id @default(autoincrement())
  cid              String   @unique
  username         String
  password         String
  email            String   @default("")
  qq               String   @default("")
  avatar           String   @default("")
  rating           Int      @default(0)    // 平台权限等级：0=普通用户 8=协管 9=高级协管 11=管理员 12=超级管理员
  permissions      String   @default("")   // 细分权限列表，逗号分隔，如 "user,flightplan,event"
  fsdLevel         Int      @default(0)    // 统一等级：0=普通用户(飞行员) 1=OBS 2=S1 3=S2 4=S3 5=C1 6=C2 7=C3 8=I1 9=I2 10=I3 11=SUP 12=ADM
  totalPilotTime   Int      @default(0)    // 累计机组在线时长(秒)
  totalAtcTime     Int      @default(0)    // 累计管制在线时长(秒)

  fsdPasswordHash  String   @default("")   // SHA256 六进制（64字符），供 FSD 挑战-响应认证使用
  bgImage          String   @default("")
  resetCode        String?  @default("")
  resetCodeExpires DateTime?
  createdAt        DateTime @default(now())

  // ===== 证据链：注册来源（2026-08-05 新增）=====
  registerIp        String   @default("")   // 注册时的真实 IP
  registerFp        String   @default("")   // 注册时的设备指纹（同设备确认）
  registerUserAgent String   @default("")   // 注册时的浏览器 UA

  @@index([registerIp])
  @@index([registerFp])
}

model Meeting {
  id      Int    @id @default(autoincrement())
  title   String
  date    String
  size    String
  content String @db.LongText
  status  String @default("ready")
}

model Feedback {
  id      Int    @id @default(autoincrement())
  userId  String
  title   String
  type    String
  content String
  status  String @default("待处理")
  time    String

  @@index([userId])
  @@index([status])
}

model Application {
  id              Int    @id @default(autoincrement())
  userId          String
  name            String
  type            String
  department      String
  reason          String
  status          String @default("待审核")
  time            String
  interviewTime1  String @default("")
  interviewTime2  String @default("")
  reviewComment   String @default("")
  reviewedBy      String @default("")

  @@index([userId])
  @@index([type])
  @@index([status])
}

model Event {
  id           Int    @id @default(autoincrement())
  title        String
  date         String
  time         String @default("")
  dep          String
  arr          String
  route        String
  publisher    String
  distance     String
  notams       String
  atcPositions String @db.Text
  desc         String
  poster       String @default("")
  status       String @default("筹备中")
}

model EmailLog {
  id         Int      @id @default(autoincrement())
  to         String
  subject    String
  type       String   @default("")     // verify / notification / security / review
  status     String   @default("sent") // sent / failed
  error      String   @default("")
  cid        String   @default("")
  createdAt  DateTime @default(now())
}

model CheckInRecord {
  id         Int    @id @default(autoincrement())
  userId     String
  eventId    String
  eventTitle String
  time       String
}

model Staff {
  cid        Int    @id
  name       String
  department String
  position   String
  rating     String @default("")
  active     Boolean @default(true)
  online     Boolean @default(false)
}

model Announcement {
  id        Int     @id @default(autoincrement())
  title     String
  content   String
  publisher String
  time      String
  pinned    Boolean @default(false)
}

model FlightTrack {
  id          Int      @id @default(autoincrement())
  callsign    String   @db.VarChar(16)
  sessionId   Int      @default(0)   // FlightLog.id（一次连线一个会话）
  lat         Float
  lon         Float
  altitude    Int      @default(0)
  groundSpeed Int      @default(0)
  heading     Int      @default(0)
  onGround    Boolean  @default(false)
  recordedAt  DateTime @default(now())

  @@index([callsign, recordedAt])
  @@index([sessionId])
}

model FlightPlan {
  id           Int     @id @default(autoincrement())
  userId       String
  callsign     String
  flightType   String  @default("IFR")
  aircraft     String
  wakeCategory String  @default("")
  equipment    String  @default("")
  transponder  String  @default("")
  depIcao      String
  depTime      String  @default("")
  cruiseAlt    String  @default("")
  cruiseSpeed  String  @default("")
  arrIcao      String
  alternate    String  @default("")
  flightTime   String  @default("")
  endurance    String  @default("")
  route        String  @default("")
  remarks      String  @default("")
  shareId      String  @default("")
  filedAt      String  @default("")
  syncFsd      Boolean @default(false)
  locked       Boolean @default(false)   // 管制 $AM 修正后锁定

  @@index([userId])
  @@index([depIcao])
  @@index([arrIcao])
}

model Ticket {
  id        Int     @id @default(autoincrement())
  userId    String
  title     String
  category  String  @default("general")
  priority  String  @default("normal")
  content   String
  status    String  @default("open")
  assignee  String  @default("")
  reply     String  @default("")
  createdAt String
  updatedAt String

  @@index([userId])
  @@index([status])
}

// ========== Feature 1: 活动报名 ==========
model EventRegistration {
  id        Int     @id @default(autoincrement())
  eventId   Int
  userId    String
  type      String  @default("pilot")    // pilot, controller
  callsign  String  @default("")
  aircraft  String  @default("")
  position  String  @default("")         // ATC 席位呼号（管制员报名时）
  frequency String  @default("")         // 管制频率（管制员报名时）
  status    String  @default("registered") // registered, checked_in, completed, absent, cancelled
  createdAt String
  updatedAt String
  @@index([eventId])
  @@index([userId])
}

// ========== Feature 2: 消息通知 ==========
model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  type      String   // system, event, apply, ticket, feedback, flightplan
  title     String
  content   String   @default("")
  link      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
}

// ========== Feature 3: 飞行记录 ==========
model FlightLog {
  id          Int     @id @default(autoincrement())
  userId      String
  callsign    String
  aircraft    String  @default("")
  depIcao     String  @default("")
  arrIcao     String  @default("")
  route       String  @default("")
  flightTime  String  @default("")
  distance    String  @default("")
  depTime     String  @default("")
  arrTime     String  @default("")
  status      String  @default("completed")
  eventId     Int     @default(0)
  createdAt   DateTime @default(now())
  // 修复(2026-10-16)：fsd-py 的上线/下线日志需要这两列，而生产表从未创建 →
  // 每次客户端上线都报 "Unknown column 'createdIp'"，在线日志 100% 写入失败
  createdIp   String  @default("")
  offlineAt   DateTime?
}

// ========== Feature 4: 积分与成就 ==========
model UserPoint {
  id        Int      @id @default(autoincrement())
  userId    String   @unique
  points    Int      @default(0)
  exp       Int      @default(0)
  level     Int      @default(1)
  flights   Int      @default(0)
  hours     Float    @default(0)
  updatedAt DateTime @default(now())
}

model Achievement {
  id          Int    @id @default(autoincrement())
  name        String
  description String
  icon        String @default("")
  criteria    String @default("")
  condition   String @default("")
  // 修复(2026-10-16)：下方 UserAchievement 需要反向关系字段，否则 /api/points 的
  // include: { achievement: true } 会抛 "Unknown argument achievement" → 接口 500
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            Int      @id @default(autoincrement())
  userId        String
  achievementId Int
  earnedAt      DateTime @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id])
}

// ========== Feature 8: 管制席位 ==========
model ControllerSchedule {
  id        Int    @id @default(autoincrement())
  eventId   Int
  cid       String
  // 修复(2026-10-16)：前端与接口均按 date 查询/展示，此前模型缺少该列导致接口 500
  date      String @default("")
  position  String
  frequency String @default("")
  startTime String @default("")
  endTime   String @default("")
  status    String @default("pending") // pending, active, completed
}

// ========== FSD 在线快照表（由 fsd-py 写入，平台 API 只读）==========
// 修复(2026-10-16)：两张表从未创建，导致 fsd-py 每 2 秒告警
// "Table 'cwfly.FlightPilot' doesn't exist"，且 /api/flightplans/fsd/online、
// /fsd/controllers 恒抛异常被吞成 { data: [], source: 'error' }（在线列表/地图恒空）。
// 列与 fsd-py/db.py 的 upsert_pilot / upsert_controller 严格对齐；callsign 为主键
// （upsert 依赖 ON DUPLICATE KEY）。
model FlightPilot {
  callsign      String   @id
  cid           String   @default("")
  realname      String   @default("")
  home          String   @default("")
  latitude      Float    @default(0)
  longitude     Float    @default(0)
  altitude      Int      @default(0)
  bank          Int      @default(0)
  pitch         Int      @default(0)
  heading       Int      @default(0)
  AltitudeC     Int      @default(0)
  groundspd     Int      @default(0)
  transponder   Int      @default(0)
  transpondermd Int      @default(0)
  updatedAt     DateTime @default(now())

  @@index([updatedAt])
}

model FlightController {
  callsign     String   @id
  cid          String   @default("")
  realname     String   @default("")
  latitude     Float    @default(0)
  longitude    Float    @default(0)
  frequency    String   @default("")
  facilityType Int      @default(0)
  visualRange  Int      @default(0)
  updatedAt    DateTime @default(now())

  @@index([updatedAt])
}

// ========== Feature 9: 培训考试 ==========
model TrainingCourse {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @default("")
  category    String   @default("")
  content     String   @db.Text
  status      String   @default("draft")
  createdAt   DateTime @default(now())
}

model TrainingExam {
  id         Int    @id @default(autoincrement())
  title      String
  courseId   Int    @default(0)
  questions  String @default("[]") // JSON
  passingScore Int  @default(60)
}

model TrainingRecord {
  id        Int      @id @default(autoincrement())
  userId    String
  courseId  Int
  examId    Int      @default(0)
  score     Int      @default(0)
  passed    Boolean  @default(false)
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ========== Feature 10: 机场资料 ==========
model Airport {
  icao       String @id
  name       String @default("")
  iata       String @default("")
  city       String @default("")
  country    String @default("")
  lat        Float  @default(0)
  lon        Float  @default(0)
  elevation  Int    @default(0)
  timezone   String @default("")
  magnetic   Float  @default(0)   // 磁偏角
  isMilitary Boolean @default(false)

  // JSON 数组，格式: [{"name":"120.3","type":"TWR","frequency":"120.300"}]
  frequencies String @default("[]")
  // JSON 数组，格式: [{"ident":"18L/36R","length":3800,"surface":"沥青"}]
  runways     String @default("[]")
}

// ========== Feature 11: 论坛 ==========
model ForumBoard {
  id          Int    @id @default(autoincrement())
  name        String
  description String @default("")
  sort        Int    @default(0)
}

model ForumPost {
  id        Int      @id @default(autoincrement())
  boardId   Int
  userId    String
  title     String
  content   String
  pinned    Boolean  @default(false)
  locked    Boolean  @default(false)
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([boardId])
  @@index([userId])
  @@index([createdAt])
}

model ForumReply {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    String
  content   String
  createdAt DateTime @default(now())

  @@index([postId])
}

// ========== Feature 12: 知识库 ==========
model KnowledgeBase {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @db.Text
  category  String   @default("")
  tags      String   @default("")
  views     Int      @default(0)
  status    String   @default("published")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

// ========== Feature 13: 活动评价 ==========
model ActivityReview {
  id        Int      @id @default(autoincrement())
  eventId   Int
  userId    String
  rating    Int      @default(5)
  comment   String   @default("")
  createdAt DateTime @default(now())
}

// ========== Feature 16: 申请流程完善 ==========
model ApplicationReply {
  id        Int      @id @default(autoincrement())
  appId     Int
  userId    String
  content   String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ========== Feature 17: 工单回复对话 ==========
model TicketReply {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  userId    String
  content   String
  attachment String @default("")
  createdAt DateTime @default(now())
}

// ========== Feature 20: 真实日志 ==========
model LoginLog {
  id         Int      @id @default(autoincrement())
  userId     String
  ip         String   @default("")
  loginLocation String @default("")   // 登录地点，用于检测异地登录
  userAgent  String   @default("")
  success    Boolean  @default(true)
  createdAt  DateTime @default(now())

  // ===== 证据链：设备指纹/事件类型（2026-08-05 新增）=====
  deviceFp   String   @default("")   // 设备指纹（X-Device-Fp / cw_device_fp）
  type       String   @default("login") // login=登录 / register=注册
  failReason String   @default("")   // 失败原因（如 password/notfound/blocked）

  @@index([userId])
  @@index([ip])
  @@index([deviceFp])
  @@index([createdAt])
}

model OnlineUser {
  cid      String   @id
  username String   @default("")
  lastSeen DateTime @default(now())

  @@map("OnlineUser")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    String
  action    String
  target    String   @default("")
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ========== 登录失败锁定（数据库共享，跨 PM2 集群实例生效，2026-08-05 新增） ==========
// 内存限流在 cluster×4 下每实例独立，无法真正限制 5 次；改由本表跨实例计数。
// 同一账号 15 分钟内失败 5 次 → 锁定 15 分钟；成功登录即清空该账号记录。
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  userId    String
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ========== 安全监控：追踪像素 + IP 记录（24h 自动清理） ==========
model SecurityEvent {
  id        Int      @id @default(autoincrement())
  ip        String   @default("")
  userAgent String   @default("")
  referrer  String   @default("")
  path      String   @default("")
  country   String   @default("")
  city      String   @default("")
  blocked   Boolean  @default(false)
  createdAt DateTime @default(now())

  // ===== 证据链：设备/用户/网络（2026-08-05 新增）=====
  deviceFp  String   @default("")   // 设备指纹（pixel._fp / X-Device-Fp）
  userId    String   @default("")   // 登录用户 CID（pixel._uid）
  network   String   @default("")   // 网络信息：effectiveType|downlink|rtt|saveData 或 {ssid,bssid}

  @@index([createdAt])
  @@index([ip])
  @@index([deviceFp])
  @@index([userId])
}

// ========== Feature 21: RBAC 权限 ==========
model Role {
  id          Int    @id @default(autoincrement())
  name        String @unique
  description String @default("")
}

model Permission {
  id          Int    @id @default(autoincrement())
  name        String @unique
  description String @default("")
}

// ========== Feature 23: 系统配置 ==========
model SystemConfig {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @default("")
}

// ========== Feature 26: 收藏 ==========
model UserFavorite {
  id        Int      @id @default(autoincrement())
  userId    String
  type      String   // airport, chart, route, flightplan
  targetId  String
  label     String   @default("")
  createdAt DateTime @default(now())
}

// ========== 验证码（多实例共享） ==========
model VerificationCode {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// ========== 验证码发送冷却（多实例共享） ==========
// 用数据库记录上次发送时间，PM2 多实例/进程重启均一致，防刷新页面或换实例绕过冷却
model EmailCooldown {
  email      String   @id
  lastSendAt DateTime
}

// ========== IP 封禁 ==========
// ip 支持单个 IP（如 1.2.3.4）或 CIDR 网段（如 1.2.3.0/24）
// expiresAt 为 null 表示永久封禁；active=false 表示已解封
model IpBan {
  id          Int      @id @default(autoincrement())
  ip          String   @unique
  reason      String   @default("")
  bannedBy    String   @default("")
  bannedUser  String   @default("") 
  active      Boolean  @default(true)
  expiresAt DateTime?
  createdAt DateTime @default(now())

  @@index([active])
  @@index([ip])
}

// ========== 网络管理（IP 白/黑名单） ==========
// type: white=白名单（放行） black=黑名单（拦截）
// ip 支持单个 IP（如 1.2.3.4）或 CIDR 网段（如 1.2.3.0/24）；active=false 表示停用
model IpList {
  id        Int      @id @default(autoincrement())
  ip        String   @unique
  type      String   @default("black")
  reason    String   @default("")
  addedBy   String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([type])
  @@index([active])
}

// ========== 网络管理（IP 集合） ==========
// 一个集合（IpGroup）包含多个 IP（IpGroupMember）
// type: white=白名单 black=黑名单；active=false 表示停用
model IpGroup {
  id        Int      @id @default(autoincrement())
  name      String   @default("")
  type      String   @default("black")
  reason    String   @default("")
  addedBy   String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  members   IpGroupMember[]

  @@index([type])
  @@index([active])
}

model IpGroupMember {
  id        Int      @id @default(autoincrement())
  groupId   Int
  ip        String
  createdAt DateTime @default(now())
  group     IpGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([ip])
}

// ========== 用户变更审批（非超管删除用户 / 删除+封禁需超管审批） ==========
model UserChangeApproval {
  id          Int      @id @default(autoincrement())
  cid         String
  username    String   @default("")
  action      String   @default("delete")     // delete=仅删除 delete_ban=删除+封禁
  ips         String   @default("")            // 待封禁 IP（逗号分隔）
  reason      String   @default("")
  requestedBy String   @default("")            // 申请人 CID
  status      String   @default("pending")     // pending/approved/rejected
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?
  reviewedBy  String   @default("")

  @@index([status])
  @@index([cid])
}

// ========== 网络日志（每 IP 每 10 分钟窗口一条, 超 10 分钟新增一行） ==========
model IpVisit {
  id          Int      @id @default(autoincrement())
  ip          String
  windowStart DateTime   // 10 分钟窗口开始时间(对齐到整 10 分钟)
  count       Int      @default(1)    // 窗口内请求次数
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())
  deviceFp    String   @default("")   // 窗口内最近一次访问的设备指纹（X-Device-Fp）

  @@unique([ip, windowStart])
  @@index([lastSeen])
  @@index([ip])
}

// ========== 设备指纹封禁（账号封禁时同步拉黑设备，防换小号注册/登录绕过） ==========
model DeviceBan {
  id       Int      @id @default(autoincrement())
  fp       String   @unique            // 设备指纹（X-Device-Fp）
  reason   String   @default("")
  bannedBy String   @default("")
  bannedAt DateTime @default(now())
}
